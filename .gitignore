# Local development and visual-test artifacts
.learnings/
.workbuddy/
web/.fix-tmp/
web/.playwright-cli/
# Playwright artifacts: traces and snapshots from a failing run.
web/test-results/
web/playwright-report/
web/output/

# Keep the Wails embed root present without tracking generated frontend assets.
!web/dist/
web/dist/*
!web/dist/.gitkeep

# Wails production build outputs are reproducible Task 9 artifacts.
# Keep source/configuration outside these exact generated output paths trackable.
build/bin/
build/appicon.png
build/windows/
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<

# Local agent scratch: plan-mode working files and the patch scripts a package used. They are
# per-session and per-machine, and committing them buried a real change under a hundred of them.
.zcode/

# Machine-local toolchain environment (local Go/gcc paths; not repo material)
scripts/local-toolchain-env.sh

# Local tool state (OMX)
.omx/
# Local scratch dir
dev/
# Stray build binary
infinite-atelier-mine-0903.exe

# Playwright root-level test output (error contexts)
test-results/
