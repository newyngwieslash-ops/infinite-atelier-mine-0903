{
  "apiVersion": "atelier.provider/v1",
  "kind": "provider",
  "name": "acme-media",
  "capability": "audio",
  "http": {
    "submitPath": "/v1/say",
    "headers": {
      "Accept": "application/json"
    }
  },
  "mapping": {
    "dataField": "audio_base64",
    "mimeField": "mime",
    "template": "{\"model\":\"{{model}}\",\"text\":\"{{text}}\",\"script\":\"{{eval}}\"}"
  }
}
