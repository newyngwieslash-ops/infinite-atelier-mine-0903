{
  "apiVersion": "atelier.agent/v1",
  "kind": "AgentPack",
  "metadata": {
    "name": "production",
    "version": "1.0.0"
  },
  "agents": [
    {
      "key": "production.decision",
      "layer": "decision",
      "skill": "decision.md",
      "inputSchema": "schemas/agent/decision-request.v1.json",
      "outputSchema": "schemas/agent/decision-result.v1.json",
      "allowedTools": [
        "workflow.read_state",
        "workflow.request_user_gate",
        "memory.deep_recall"
      ],
      "limits": {
        "maxToolCalls": 6,
        "timeoutSeconds": 180
      }
    },
    {
      "key": "production.execution.director_plan",
      "layer": "execution",
      "skill": "execution/director_plan.md",
      "inputSchema": "schemas/agent/execution-request.v1.json",
      "outputSchema": "schemas/agent/execution-result.v1.json",
      "allowedTools": [
        "script.read_script_version",
        "storyboard.create_director_plan_version"
      ],
      "limits": {
        "maxToolCalls": 8,
        "timeoutSeconds": 300
      }
    },
    {
      "key": "production.execution.asset_analysis",
      "layer": "execution",
      "skill": "execution/asset_analysis.md",
      "inputSchema": "schemas/agent/execution-request.v1.json",
      "outputSchema": "schemas/agent/execution-result.v1.json",
      "allowedTools": [
        "story.read_events",
        "asset.read_approved_assets"
      ],
      "limits": {
        "maxToolCalls": 8,
        "timeoutSeconds": 300
      }
    },
    {
      "key": "production.execution.asset_generation_plan",
      "layer": "execution",
      "skill": "execution/asset_generation_plan.md",
      "inputSchema": "schemas/agent/execution-request.v1.json",
      "outputSchema": "schemas/agent/execution-result.v1.json",
      "allowedTools": [
        "asset.read_approved_assets",
        "asset.create_candidate_version"
      ],
      "limits": {
        "maxToolCalls": 8,
        "timeoutSeconds": 300
      }
    },
    {
      "key": "production.execution.storyboard_table",
      "layer": "execution",
      "skill": "execution/storyboard_table.md",
      "inputSchema": "schemas/agent/execution-request.v1.json",
      "outputSchema": "schemas/agent/execution-result.v1.json",
      "allowedTools": [
        "script.read_script_version",
        "storyboard.read_director_plan",
        "storyboard.create_storyboard_version"
      ],
      "limits": {
        "maxToolCalls": 8,
        "timeoutSeconds": 300
      }
    },
    {
      "key": "production.execution.storyboard_panel",
      "layer": "execution",
      "skill": "execution/storyboard_panel.md",
      "inputSchema": "schemas/agent/execution-request.v1.json",
      "outputSchema": "schemas/agent/execution-result.v1.json",
      "allowedTools": [
        "storyboard.read_storyboard",
        "storyboard.create_storyboard_panel_version"
      ],
      "limits": {
        "maxToolCalls": 8,
        "timeoutSeconds": 300
      }
    },
    {
      "key": "production.supervision.director_plan",
      "layer": "supervision",
      "skill": "supervision/director_plan.md",
      "inputSchema": "schemas/agent/supervision-request.v1.json",
      "outputSchema": "schemas/agent/review-report.v1.json",
      "allowedTools": [
        "script.read_script_version",
        "storyboard.read_director_plan"
      ],
      "limits": {
        "maxToolCalls": 12,
        "timeoutSeconds": 300
      }
    },
    {
      "key": "production.supervision.storyboard_table",
      "layer": "supervision",
      "skill": "supervision/storyboard_table.md",
      "inputSchema": "schemas/agent/supervision-request.v1.json",
      "outputSchema": "schemas/agent/review-report.v1.json",
      "allowedTools": [
        "storyboard.read_storyboard",
        "script.read_script_version"
      ],
      "limits": {
        "maxToolCalls": 12,
        "timeoutSeconds": 300
      }
    },
    {
      "key": "production.supervision.storyboard_panel",
      "layer": "supervision",
      "skill": "supervision/storyboard_panel.md",
      "inputSchema": "schemas/agent/supervision-request.v1.json",
      "outputSchema": "schemas/agent/review-report.v1.json",
      "allowedTools": [
        "storyboard.read_storyboard",
        "asset.read_approved_assets"
      ],
      "limits": {
        "maxToolCalls": 12,
        "timeoutSeconds": 300
      }
    }
  ]
}
