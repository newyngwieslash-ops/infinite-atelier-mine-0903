{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-atelier.invalid/schemas/agent/tools/storyboard.read_storyboard.json",
  "title": "storyboard.read_storyboard input",
  "description": "Returns one storyboard version together with its items in ordinal order, bounded so a large board does not travel whole.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "versionId": {
      "type": "string",
      "description": "The storyboard version to read.",
      "minLength": 1,
      "maxLength": 200
    },
    "limit": {
      "type": "integer",
      "description": "How many items to return.",
      "minimum": 1,
      "maximum": 200
    }
  },
  "required": [
    "versionId"
  ]
}
